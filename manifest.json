{
  "manifest_version": 3,
  "name": "Personal Analytics Debugger",
  "version": "1.1.0",
  "description": "Intercepta los hits 'collect' enviados a Google Analytics 4 y los imprime estructurados (event_name, event_params, user_params, items, analytics info) en la consola de la pagina. Se puede activar/desactivar desde el popup.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Personal Analytics Debugger",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
